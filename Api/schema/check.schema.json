{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API check",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "protocols",
    "kind",
    "priority",
    "tags",
    "preconditions",
    "steps",
    "expected",
    "applicability",
    "automation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "rest",
          "grpc",
          "graphql",
          "websocket",
          "generic"
        ]
      }
    },
    "kind": {
      "enum": [
        "positive",
        "negative",
        "boundary",
        "security",
        "reliability",
        "compatibility",
        "performance",
        "contract"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "applicability": {
      "type": "object",
      "required": [
        "when",
        "skip_when"
      ],
      "properties": {
        "when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skip_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "required": [
        "level",
        "deterministic"
      ],
      "properties": {
        "level": {
          "enum": [
            "full",
            "partial",
            "manual"
          ]
        },
        "deterministic": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "risk": {
      "type": "object",
      "properties": {
        "impact": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "likelihood": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}