build/coverage/generated_checks/
build/coverage/coverage_matrix.json
build/coverage/coverage_report.json
build/real-contract-coverage/*.json
build/real-contract-coverage/*.txt

# Local test outputs
artifacts/
test-results/
allure-results/
allure-report/
