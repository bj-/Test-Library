{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution profile",
  "type": "object",
  "required": [
    "id",
    "description",
    "include_tags",
    "exclude_tags",
    "max_priority",
    "selection"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "include_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "selection": {
      "type": "object",
      "required": [
        "deterministic_only",
        "max_checks"
      ],
      "properties": {
        "deterministic_only": {
          "type": "boolean"
        },
        "max_checks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}