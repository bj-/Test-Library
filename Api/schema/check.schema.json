{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/api-test-library/check.schema.json",
  "title": "API Test Check",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "category",
    "objective",
    "applies_to",
    "expected_behavior",
    "suites",
    "priority_default",
    "include_if",
    "exclude_if",
    "automation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3,}$"
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "category": {
      "type": "object",
      "required": [
        "domain",
        "group"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "subcategory": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "applies_to": {
      "type": "object",
      "required": [
        "protocols"
      ],
      "properties": {
        "protocols": {
          "type": "array",
          "items": {
            "enum": [
              "REST",
              "GRPC"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "operation_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "polarity": {
      "type": "array",
      "items": {
        "enum": [
          "Positive",
          "Negative"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "suites": {
      "type": "array",
      "items": {
        "enum": [
          "Smoke",
          "Regression",
          "Contract",
          "Security",
          "Performance",
          "Reliability",
          "Compatibility",
          "Integration",
          "Exploratory"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "priority_default": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "risk_default": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ]
    },
    "include_if": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude_if": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_behavior": {
      "type": "object",
      "required": [
        "source",
        "rules"
      ],
      "properties": {
        "source": {
          "enum": [
            "contract",
            "business_rule",
            "standard",
            "needs_clarification"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "error_mapping": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "verify": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tolerance": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "execution_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "max_variants": {
            "type": "integer",
            "minimum": 0
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "additionalProperties": false
      }
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "required": [
        "mode",
        "deterministic"
      ],
      "properties": {
        "mode": {
          "enum": [
            "Automated",
            "Assisted",
            "Manual"
          ]
        },
        "deterministic": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "data_strategy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserve_seed": {
          "type": "boolean"
        },
        "deduplicate": {
          "type": "boolean"
        },
        "max_generated_cases": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}